+// Diagnostic printing only: avoids Eigen ABI differences between Drake binaries
+// and host Eigen headers. No optimizer code or state calculations change.
+template <typename Derived>
+std::string FormatMatrixDiagnostic(const Eigen::MatrixBase<Derived>& m) {
+  std::ostringstream ss;
+  ss << std::setprecision(12) << "[";
+  for (int i = 0; i < m.rows(); ++i) {
+    if (i) ss << "; ";
+    for (int j = 0; j < m.cols(); ++j) {
+      if (j) ss << ", ";
+      ss << m(i, j);
+    }
+  }
+  ss << "]";
+  return ss.str();
+}
