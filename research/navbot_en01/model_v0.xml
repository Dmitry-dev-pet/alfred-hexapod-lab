<mujoco model="NavBot_EN01_APPROX_v0_not_CAD">
  <!-- Hand-authored approximation, NOT converted from upstream CAD. -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <default>
    <joint damping="0.0005" armature="0.00002" frictionloss="0.0001"/>
    <geom condim="3" friction="0.9 0.005 0.0001" solref="0.008 1" solimp="0.9 0.95 0.001"/>
  </default>
  <worldbody>
    <light pos="0 -0.4 1.0" dir="0 0 -1"/>
    <geom name="floor" type="plane" pos="0 0 0" size="3 3 0.1" rgba="0.82 0.83 0.85 1"/>
    <body name="torso" pos="0 0 0.090">
      <freejoint name="root"/>
      <geom name="torso_geom" type="box" size="0.047 0.034 0.024" mass="0.180" rgba="0.2 0.3 0.4 1"/>
      <site name="imu_site" pos="0 0 0" size="0.002"/>
      <body name="left_leg" pos="0 0.043 -0.016">
        <joint name="hip_left" type="hinge" axis="0 1 0" limited="true" range="-1.05 1.05"/>
        <geom name="left_leg_geom" type="capsule" fromto="0 0 0 0.014 0 -0.050" size="0.007" mass="0.024" rgba="0.25 0.26 0.28 1"/>
        <body name="left_wheel" pos="0.014 0 -0.050">
          <joint name="wheel_left" type="hinge" axis="0 1 0" damping="0.0002" armature="0.00005"/>
          <geom name="left_wheel_geom" type="cylinder" size="0.024 0.009" quat="0.707106781 0.707106781 0 0" mass="0.047" rgba="0.08 0.08 0.09 1"/>
        </body>
      </body>
      <body name="right_leg" pos="0 -0.043 -0.016">
        <joint name="hip_right" type="hinge" axis="0 1 0" limited="true" range="-1.05 1.05"/>
        <geom name="right_leg_geom" type="capsule" fromto="0 0 0 0.014 0 -0.050" size="0.007" mass="0.024" rgba="0.25 0.26 0.28 1"/>
        <body name="right_wheel" pos="0.014 0 -0.050">
          <joint name="wheel_right" type="hinge" axis="0 1 0" damping="0.0002" armature="0.00005"/>
          <geom name="right_wheel_geom" type="cylinder" size="0.024 0.009" quat="0.707106781 0.707106781 0 0" mass="0.047" rgba="0.08 0.08 0.09 1"/>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <!-- Leg stall torque *only* as an upper bound. probe.py enforces lower rated limit by default. -->
    <motor name="a_hip_left" joint="hip_left" gear="1" ctrllimited="true" ctrlrange="-0.4413 0.4413"/>
    <motor name="a_hip_right" joint="hip_right" gear="1" ctrllimited="true" ctrlrange="-0.4413 0.4413"/>
    <!-- Wheel torque is an UNVERIFIED sensitivity parameter, not the 90KV rating. -->
    <motor name="a_wheel_left" joint="wheel_left" gear="1" ctrllimited="true" ctrlrange="-0.030 0.030"/>
    <motor name="a_wheel_right" joint="wheel_right" gear="1" ctrllimited="true" ctrlrange="-0.030 0.030"/>
  </actuator>
  <sensor>
    <gyro name="imu_gyro" site="imu_site"/>
    <accelerometer name="imu_acc" site="imu_site"/>
    <jointpos name="hip_left_pos" joint="hip_left"/>
    <jointpos name="hip_right_pos" joint="hip_right"/>
    <jointvel name="wheel_left_speed" joint="wheel_left"/>
    <jointvel name="wheel_right_speed" joint="wheel_right"/>
  </sensor>
</mujoco>
